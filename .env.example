OPENAI_API_KEY=
TELEGRAM_TOKEN=
OPENAI_MODEL=gpt-6-luna
APP_VERSION=1.01
# OPERATOR_DB defaults to operator.sqlite3 in this repository

# Optional existing local proxy for OpenAI only
OPENAI_PROXY=

# Optional trusted initial numeric admin ID; otherwise use a one-time /claim binding
ADMIN_TELEGRAM_ID=

OPENAI_REASONING_EFFORT=low
OPENAI_FALLBACK_REASONING_EFFORT=medium
# Optional price estimates, USD per million tokens; empty means cost unknown
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
